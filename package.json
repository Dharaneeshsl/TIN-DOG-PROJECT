{
  "name": "tin-dog-app",
  "version": "3.0.0",
  "description": "Production-ready dog matching and premium membership platform",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "nodemon server.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --globals",
    "test:watch": "vitest",
    "lint": "node --check server.js && eslint . && vite build"
  },
  "keywords": [
    "dog-dating",
    "matching",
    "react",
    "express",
    "sqlite",
    "payments"
  ],
  "author": "TIN-DOG Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "razorpay": "^2.9.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^18.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
