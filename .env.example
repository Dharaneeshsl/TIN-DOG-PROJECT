NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=./data/tindog.sqlite
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
SEED_DEMO_DATA=false

# Payment provider: stripe or razorpay
PAYMENT_PROVIDER=stripe
CURRENCY=usd

# Stripe Checkout + webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay Orders + webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Browser CORS; comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Account verification and password recovery
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_FROM=TIN-DOG <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional production controls
TRUST_PROXY=false
ADMIN_EMAILS=
DISCOVERY_PAGE_SIZE=24

# Optional frontend API origin when the client is deployed separately
VITE_API_BASE_URL=
